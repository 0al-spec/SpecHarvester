{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-harvester.dev/schemas/local-candidate-review-workbench-v0.schema.json",
  "title": "Local Candidate Review Workbench Schema Bundle",
  "oneOf": [
    {"$ref": "#/$defs/fixture"},
    {"$ref": "#/$defs/catalog"},
    {"$ref": "#/$defs/detail"},
    {"$ref": "#/$defs/comparison"},
    {"$ref": "#/$defs/decision"},
    {"$ref": "#/$defs/reasons"},
    {"$ref": "#/$defs/export"}
  ],
  "$defs": {
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "catalog", "detail", "comparison", "decision", "reasons", "export"],
      "properties": {
        "apiVersion": {"const": "spec-harvester.local-candidate-review-schema-fixture/v0"},
        "kind": {"const": "SpecHarvesterLocalCandidateReviewSchemaFixture"},
        "catalog": {"$ref": "#/$defs/catalog"},
        "detail": {"$ref": "#/$defs/detail"},
        "comparison": {"$ref": "#/$defs/comparison"},
        "decision": {"$ref": "#/$defs/decision"},
        "reasons": {"$ref": "#/$defs/reasons"},
        "export": {"$ref": "#/$defs/export"}
      }
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidateId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId", "packetSha256"],
      "properties": {
        "candidateId": {"$ref": "#/$defs/candidateId"},
        "packetSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "authority", "sourceBundleSha256", "items"],
      "properties": {
        "apiVersion": {"const": "spec-harvester.candidate-review-catalog/v0"},
        "kind": {"const": "SpecHarvesterCandidateReviewCatalog"},
        "authority": {"const": "local_review_catalog_evidence_only"},
        "sourceBundleSha256": {"$ref": "#/$defs/sha256"},
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["candidateId", "packetSha256", "reviewState", "readiness", "ecosystem", "packageShape", "warningCount", "corrected", "preflightStatus"],
            "properties": {
              "candidateId": {"$ref": "#/$defs/candidateId"},
              "packetSha256": {"$ref": "#/$defs/sha256"},
              "reviewState": {"enum": ["unreviewed", "in_review", "accept_for_intake", "request_revision", "defer", "do_not_promote"]},
              "readiness": {"enum": ["ready_for_author_review", "blocked"]},
              "ecosystem": {"type": "string", "minLength": 1},
              "packageShape": {"type": "string", "minLength": 1},
              "warningCount": {"type": "integer", "minimum": 0},
              "corrected": {"type": "boolean"},
              "preflightStatus": {"enum": ["passed", "warning", "error", "not_run"]}
            }
          }
        }
      }
    },
    "detail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "authority", "binding", "previewOnly", "sections"],
      "properties": {
        "apiVersion": {"const": "spec-harvester.candidate-review-detail/v0"},
        "kind": {"const": "SpecHarvesterCandidateReviewDetail"},
        "authority": {"const": "local_review_detail_evidence_only"},
        "binding": {"$ref": "#/$defs/binding"},
        "previewOnly": {"const": true},
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "contentType", "content"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "contentType": {"enum": ["text/plain", "application/json", "application/yaml"]},
              "content": {"type": "string"}
            }
          }
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "authority", "binding", "static", "ai"],
      "properties": {
        "apiVersion": {"const": "spec-harvester.candidate-review-comparison/v0"},
        "kind": {"const": "SpecHarvesterCandidateReviewComparison"},
        "authority": {"const": "local_review_comparison_evidence_only"},
        "binding": {"$ref": "#/$defs/binding"},
        "static": {
          "type": "object",
          "additionalProperties": false,
          "required": ["memberCount"],
          "properties": {
            "memberCount": {"type": "integer", "minimum": 0}
          }
        },
        "ai": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": {"enum": ["complete_portable", "portable", "summary_only_not_portable", "not_available", "campaign_rejected"]},
            "warningCount": {"type": "integer", "minimum": 0},
            "proposalSha256": {"$ref": "#/$defs/sha256"},
            "semanticRecordSha256": {"$ref": "#/$defs/sha256"},
            "qualityReportSha256": {"$ref": "#/$defs/sha256"},
            "providerReceiptSha256": {"$ref": "#/$defs/sha256"},
            "sourceBundleSha256": {"$ref": "#/$defs/sha256"},
            "qualityStatus": {"enum": ["eligible_for_calibration", "review_required", "rejected"]},
            "campaignRecordSha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "semantic": {"$ref": "#/$defs/semanticComparison"}
      }
    },
    "semanticClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
        "text": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "sourcePath", "sha256"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "sourcePath": {"type": "string", "minLength": 1},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    },
    "semanticComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["static", "ai", "binding"],
      "properties": {
        "static": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summaries", "capabilities", "intents", "interfaces", "evidence"],
          "properties": {
            "summaries": {"type": "array", "items": {"type": "string"}},
            "capabilities": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "summary", "intentIds"],
                "properties": {
                  "id": {"type": "string", "minLength": 1},
                  "summary": {"type": "string"},
                  "intentIds": {"type": "array", "items": {"type": "string"}}
                }
              }
            },
            "intents": {"type": "array", "items": {"type": "string"}},
            "interfaces": {"type": "array", "items": {"type": "string"}},
            "evidence": {"type": "array", "items": {"type": "string"}}
          }
        },
        "ai": {
          "type": "object",
          "additionalProperties": false,
          "required": ["claims", "observedIntentReuse", "experimentalIntents"],
          "properties": {
            "claims": {
              "type": "object",
              "additionalProperties": false,
              "required": ["purpose", "capability", "interface", "nearby_intent_difference", "non_goal"],
              "properties": {
                "purpose": {"type": "array", "items": {"$ref": "#/$defs/semanticClaim"}},
                "capability": {"type": "array", "items": {"$ref": "#/$defs/semanticClaim"}},
                "interface": {"type": "array", "items": {"$ref": "#/$defs/semanticClaim"}},
                "nearby_intent_difference": {"type": "array", "items": {"$ref": "#/$defs/semanticClaim"}},
                "non_goal": {"type": "array", "items": {"$ref": "#/$defs/semanticClaim"}}
              }
            },
            "observedIntentReuse": {"type": "array", "items": {"type": "object"}},
            "experimentalIntents": {"type": "array", "items": {"type": "object"}}
          }
        },
        "binding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["semanticRecordSha256", "proposalSha256", "sourceBundleSha256"],
          "properties": {
            "semanticRecordSha256": {"$ref": "#/$defs/sha256"},
            "proposalSha256": {"$ref": "#/$defs/sha256"},
            "sourceBundleSha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "authority", "binding", "disposition", "reviewer", "recordedAt", "reasonCode", "priorDecisionSha256"],
      "properties": {
        "apiVersion": {"const": "spec-harvester.candidate-review-decision/v0"},
        "kind": {"const": "SpecHarvesterCandidateReviewDecision"},
        "authority": {"const": "local_review_decision_evidence_only"},
        "binding": {"$ref": "#/$defs/binding"},
        "disposition": {"enum": ["accept_for_intake", "request_revision", "defer", "do_not_promote"]},
        "reviewer": {"type": "string", "minLength": 1, "maxLength": 200},
        "recordedAt": {"type": "string", "format": "date-time"},
        "reasonCode": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "notes": {"type": "string", "maxLength": 4000},
        "priorDecisionSha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "semanticReview": {"$ref": "#/$defs/semanticReview"}
      }
    },
    "semanticReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "schemaVersion", "authority", "proposalSha256", "reviewerEditSha256", "sourceBundleSha256", "semanticRecordSha256", "reviewer", "decision", "acceptedOrEditedClaimIds"],
      "properties": {
        "apiVersion": {"const": "spec-harvester.ai-semantic-reviewer-edit/v0"},
        "kind": {"const": "SpecHarvesterAISemanticReviewerEdit"},
        "schemaVersion": {"const": 1},
        "authority": {"const": "reviewer_semantic_decision_evidence_only"},
        "proposalSha256": {"$ref": "#/$defs/sha256"},
        "reviewerEditSha256": {"$ref": "#/$defs/sha256"},
        "sourceBundleSha256": {"$ref": "#/$defs/sha256"},
        "semanticRecordSha256": {"$ref": "#/$defs/sha256"},
        "reviewer": {"type": "string", "minLength": 1, "maxLength": 200},
        "decision": {"enum": ["accepted", "edited", "rejected", "deferred"]},
        "acceptedOrEditedClaimIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"}},
        "editedClaims": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claimId", "text"],
            "properties": {
              "claimId": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
              "text": {"type": "string", "minLength": 1, "maxLength": 4000}
            }
          }
        }
      }
    },
    "reasons": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "codes"],
      "properties": {
        "apiVersion": {"const": "spec-harvester.candidate-review-reasons/v0"},
        "kind": {"const": "SpecHarvesterCandidateReviewReasons"},
        "codes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "allowedDispositions", "label"],
            "properties": {
              "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
              "allowedDispositions": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"enum": ["accept_for_intake", "request_revision", "defer", "do_not_promote"]}
              },
              "label": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "authority", "sourceBundleSha256", "decisions", "registryMutationCount"],
      "properties": {
        "apiVersion": {"const": "spec-harvester.candidate-review-export/v0"},
        "kind": {"const": "SpecHarvesterCandidateReviewExport"},
        "authority": {"const": "portable_local_review_evidence_only"},
        "sourceBundleSha256": {"$ref": "#/$defs/sha256"},
        "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}},
        "registryMutationCount": {"const": 0}
      }
    }
  }
}
